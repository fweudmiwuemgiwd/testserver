#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════════════════════
# rvg — RVG Gateway management CLI (self-hosted Linux edition)
#
# Usage:  rvg <command> [args]
#
# Service:
#   status                    Show service status
#   start | stop | restart    Manage the systemd service
#   logs [-f] [N]             Show recent logs ('-f' to follow)
#
# Configuration:
#   port N                    Change panel port          (restarts service)
#   host ADDR                 Set public domain/IP       (restarts service)
#   public-port N             Set TLS port in links      (restarts service)
#                             (empty/auto = follow the real panel port when
#                              internal TLS is enabled)
#   tls on|off                Internal TLS of the panel itself:
#                               on  = panel serves HTTPS/WSS with a self-signed
#                                     certificate (default; links get allowInsecure=1)
#                               off = Caddy/nginx/router terminates TLS in front
#                                     of the panel (links use public-port, default 443)
#   password NEWPASS          Reset admin password
#   logs-off | logs-on        Disable / enable all logging
#   phone-home on|off         Opt in/out of central server contact
#   firewall                  Open required ports in ufw/firewalld
#   info                      Show installation summary
#
# Backups:
#   backup create [NAME]      Create a backup archive
#   backup list               List available backups
#   backup restore FILE       Restore from a file ('latest' allowed)
#   backup delete NAME        Delete a backup
#
# Maintenance:
#   update                    Update RVG to the latest version
#   uninstall                 Remove RVG from this machine
# ══════════════════════════════════════════════════════════════════════════════
set -euo pipefail

SERVICE_NAME="rvg"
APP_DIR="${RVG_APP_DIR:-/opt/rvg}"
CONF_FILE="/etc/rvg.conf"
PYTHON="python3"
c_green='\033[0;32m'; c_blue='\033[0;34m'; c_yellow='\033[1;33m'; c_red='\033[0;31m'; c_off='\033[0m'
ok()   { echo -e "${c_green}[ OK ]${c_off} $*"; }
info() { echo -e "${c_blue}[INFO]${c_off} $*"; }
warn() { echo -e "${c_yellow}[WARN]${c_off} $*"; }
die()  { echo -e "${c_red}[FAIL]${c_off} $*" >&2; exit 1; }

[[ -f "$CONF_FILE" ]] && . "$CONF_FILE"
DATA_DIR="${DATA_DIR:-/var/lib/rvg}"
PORT="${PORT:-8080}"
command -v "$PYTHON" >/dev/null 2>&1 || PYTHON="$APP_DIR/venv/bin/python"

STATE_FILE="$DATA_DIR/rvg_state.json"
BACKUP_DIR="$DATA_DIR/backups"

need_root() { [[ "$(id -u)" -eq 0 ]] || die "This command must run as root: sudo rvg $*"; }

json_patch() {
  # json_patch <key> <value-as-json-literal>  — e.g. json_patch port 9090 / json_patch host '"panel.example.com"'
  local key="$1" val="$2"
  [[ -f "$STATE_FILE" ]] || die "State file not found: $STATE_FILE"
  "$PYTHON" - "$STATE_FILE" "$key" "$val" <<'EOF'
import json, sys, os
path, key, val = sys.argv[1], sys.argv[2], json.loads(sys.argv[3])
data = {}
if os.path.exists(path):
    with open(path, "r", encoding="utf-8") as f:
        raw = f.read().strip()
        if raw:
            data = json.loads(raw)
data[key] = val
tmp = path + ".tmp"
with open(tmp, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
os.replace(tmp, path)
print(f"[ OK ] state updated: {key} = {val}")
EOF
}

svc() {
  need_root "$@"
  systemctl "$@" "${SERVICE_NAME}.service"
}

hash_password() {
  # mirrors main.py hash_password(): sha256(pw + secret)
  local pw="$1"
  "$PYTHON" - "$pw" "$DATA_DIR/.rvg_secret" <<'EOF'
import hashlib, sys
pw, secret_file = sys.argv[1], sys.argv[2]
secret = ""
try:
    with open(secret_file, "r", encoding="utf-8") as f:
        secret = f.read().strip()
except FileNotFoundError:
    pass
print(hashlib.sha256(f"{pw}{secret}".encode()).hexdigest())
EOF
}

cmd_status()   { systemctl status "${SERVICE_NAME}.service" --no-pager -l || true; }
cmd_start()    { svc start;    ok "Service started"; }
cmd_stop()     { svc stop;     ok "Service stopped — panel is now offline"; }
cmd_restart()  { svc restart;  ok "Service restarted"; }

cmd_logs() {
  local follow=0 n=100
  for a in "$@"; do
    case "$a" in
      -f|--follow) follow=1 ;;
      *[!0-9]*) die "logs: bad argument '$a'" ;;
      *) n="$a" ;;
    esac
  done
  need_root logs
  if [[ "$follow" == "1" ]]; then journalctl -u "${SERVICE_NAME}" -n "$n" -f --no-pager
  else journalctl -u "${SERVICE_NAME}" -n "$n" --no-pager; fi
}

set_conf_port() {
  if grep -q "^PORT=" "$CONF_FILE" 2>/dev/null; then
    sed -i "s|^PORT=.*|PORT=$1|" "$CONF_FILE"
  else
    echo "PORT=$1" >> "$CONF_FILE"
  fi
}
set_conf_host() {
  if grep -q "^RVG_PUBLIC_HOST=" "$CONF_FILE" 2>/dev/null; then
    sed -i "s|^RVG_PUBLIC_HOST=.*|RVG_PUBLIC_HOST=$1|" "$CONF_FILE"
  else
    echo "RVG_PUBLIC_HOST=$1" >> "$CONF_FILE"
  fi
}

cmd_port() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && (( 1 <= $1 && $1 <= 65535 )) || die "usage: rvg port <1-65535>"
  need_root port
  set_conf_port "$1"
  json_patch port "$1"
  systemctl restart "${SERVICE_NAME}.service"
  ok "Panel port changed to $1 and service restarted (default URL: https://<host>:$1/ — self-signed certificate)"
}

cmd_host() {
  [[ -n "${1:-}" ]] || die "usage: rvg host <domain-or-ip>"
  local h="${1,,}"; h="${h#http://}"; h="${h#https://}"; h="${h%/}"
  need_root host
  set_conf_host "$h"
  json_patch host "\"$h\""
  systemctl restart "${SERVICE_NAME}.service"
  ok "Public host set to '$h' and service restarted"
}

cmd_public_port() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && (( 1 <= $1 && $1 <= 65535 )) || die "usage: rvg public-port <1-65535>"
  need_root public-port
  json_patch public_port "$1"
  json_patch public_port_auto false
  systemctl restart "${SERVICE_NAME}.service"
  ok "TLS port used in share links set to $1 (service restarted)"
}

cmd_tls() {
  case "${1:-}" in
    on)
      need_root tls
      json_patch tls true
      systemctl restart "${SERVICE_NAME}.service"
      ok "Internal TLS ENABLED — panel serves HTTPS/WSS with a self-signed certificate."
      info "Share links now point to the panel port and include allowInsecure=1."
      ;;
    off)
      need_root tls
      json_patch tls false
      systemctl restart "${SERVICE_NAME}.service"
      ok "Internal TLS DISABLED — put Caddy/nginx (real certificate) in front of the panel."
      info "Share links use the public-port (default 443). Example Caddyfile:"
      echo "    your.domain.com {"
      echo "        reverse_proxy 127.0.0.1:${PORT}"
      echo "    }"
      ;;
    *) die "usage: rvg tls on|off" ;;
  esac
}

cmd_password() {
  [[ -n "${1:-}" ]] || { echo "usage: rvg password <new-password>"; echo "       (min 6 characters)"; exit 1; }
  local pw="$1"; [[ ${#pw} -ge 6 ]] || die "Password must be at least 6 characters"
  need_root password
  local h; h="$(hash_password "$pw")"
  json_patch password_hash "\"$h\""
  systemctl restart "${SERVICE_NAME}.service"
  ok "Admin password updated (all sessions invalidated)"
}

toggle_logs() {
  local disabled_json="$1"; shift
  need_root logs-toggle
  json_patch disable_logging "$disabled_json"
  systemctl restart "${SERVICE_NAME}.service"
}

cmd_logs_off() {
  toggle_logs true
  ok "Logging fully disabled (app logs, access logs, error log buffers)."
  warn "Note: journald still records service stdout. To silence it completely:"
  echo "       mkdir -p /etc/systemd/system/${SERVICE_NAME}.service.d"
  echo "       printf '[Service]\nStandardOutput=null\nStandardError=null\n' > /etc/systemd/system/${SERVICE_NAME}.service.d/silent.conf"
  echo "       systemctl daemon-reload && systemctl restart ${SERVICE_NAME}"
}

cmd_logs_on() {
  toggle_logs false
  ok "Logging enabled again."
}

cmd_phone_home() {
  case "${1:-}" in
    on)  need_root phone-home; json_patch phone_home true;  ok "Central-server contact ENABLED (announcements/support active)" ;;
    off) need_root phone-home; json_patch phone_home false; ok "Central-server contact DISABLED (fully private)" ;;
    *) die "usage: rvg phone-home on|off" ;;
  esac
  systemctl restart "${SERVICE_NAME}.service"
}

cmd_firewall() {
  need_root firewall
  local ports=("${PORT}/tcp" "8500:8600/tcp")
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi active; then
    ufw allow "${PORT}/tcp" comment 'RVG Gateway'
    ufw allow 8500:8600/tcp comment 'RVG MTProto'
    ok "ufw rules added"
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --permanent --add-port="${PORT}/tcp"
    firewall-cmd --permanent --add-port=8500-8600/tcp
    firewall-cmd --reload
    ok "firewalld rules added"
  else
    warn "No supported firewall found (ufw/firewalld). Nothing to do."
  fi
}

cmd_info() {
  local ver="-"
  [[ -f "$APP_DIR/version.txt" ]] && ver=$(grep -oP '(?<=^version=).*' "$APP_DIR/version.txt" 2>/dev/null || cat "$APP_DIR/version.txt" | head -1)
  local running="no"; systemctl is-active --quiet "${SERVICE_NAME}.service" && running="yes"
  local host=""; [[ -f "$CONF_FILE" ]] && host=$(grep '^RVG_PUBLIC_HOST=' "$CONF_FILE" | cut -d= -f2-) 
  local state_host=""; [[ -f "$STATE_FILE" ]] && state_host=$("$PYTHON" -c "import json;print(json.load(open('$STATE_FILE',encoding='utf-8')).get('host') or '')" 2>/dev/null || true)
  local tls="on (self-signed)"; [[ -f "$STATE_FILE" ]] && tls=$("$PYTHON" -c "import json;d=json.load(open('$STATE_FILE',encoding='utf-8'));print('off (external TLS terminator)' if d.get('tls') is False else 'on (self-signed)')" 2>/dev/null || echo "$tls")
  local scheme="https"; [[ "$tls" == off* ]] && scheme="http"
  echo ""
  echo "  RVG Gateway · Self-Hosted Edition"
  echo "  ─────────────────────────────────────────────"
  printf "  %-18s %s\n" "Version:"        "$ver"
  printf "  %-18s %s\n" "App directory:"   "$APP_DIR"
  printf "  %-18s %s\n" "Data directory:"  "$DATA_DIR"
  printf "  %-18s %s\n" "Backups:"         "$BACKUP_DIR"
  printf "  %-18s %s\n" "Panel URL:"       "${scheme}://<server-ip>:$PORT/  (setup: /setup)"
  printf "  %-18s %s\n" "Public host:"     "${state_host:-${host:-not configured}}"
  printf "  %-18s %s\n" "Internal TLS:"    "$tls"
  printf "  %-18s %s\n" "Service:"        "$(systemctl is-active ${SERVICE_NAME} 2>/dev/null) (enabled: $(systemctl is-enabled ${SERVICE_NAME} 2>/dev/null))"
  printf "  %-18s %s\n" "Running now:"     "$running"
  echo ""
}

# ── Backups ──────────────────────────────────────────────────────────────────
backup_files=(rvg_state.json .rvg_secret update_history.json .bot_tcp_proxy_token)

cmd_backup() {
  local sub="${1:-help}"; shift || true
  mkdir -p "$BACKUP_DIR"
  case "$sub" in
    create)
      need_root backup create
      local name="${1:-}"
      local ts; ts="$(date +%Y%m%d-%H%M%S)"
      local target="$BACKUP_DIR/rvg-backup-${name:+$name-}$ts.tar.gz"
      [[ "$name" =~ ^[A-Za-z0-9_-]*$ ]] || die "backup name: only letters, digits, - _ allowed"
      local args=()
      for f in "${backup_files[@]}"; do
        [[ -f "$DATA_DIR/$f" ]] && args+=( -C "$DATA_DIR" "$f" )
      done
      ((${#args[@]})) || die "Nothing to back up — no state files found in $DATA_DIR"
      tar czf "$target" "${args[@]}"
      chmod 600 "$target"
      chown "$SERVICE_USER:$SERVICE_USER" "$target" 2>/dev/null || true
      ok "Backup created: $(basename "$target") ($(du -h "$target" | cut -f1))"
      ;;
    list)
      ls -lht "$BACKUP_DIR"/rvg-backup-*.tar.gz 2>/dev/null || { info "No backups yet — try: sudo rvg backup create"; exit 0; }
      ;;
    restore)
      local what="${1:-latest}"
      local file
      if [[ "$what" == "latest" ]]; then
        file=$(ls -t "$BACKUP_DIR"/rvg-backup-*.tar.gz 2>/dev/null | head -1) || die "No backups found"
      else
        [[ -f "$what" ]] || what="$BACKUP_DIR/$what"
        [[ -f "$what" ]] || die "Backup file not found: $1"
        file="$what"
      fi
      need_root backup restore
      warn "Restoring will REPLACE current links/subs/password with the backup contents."
      read -r -p "Type YES to continue: " ans
      [[ "$ans" == "YES" ]] || { info "Aborted."; exit 0; }
      systemctl stop "${SERVICE_NAME}.service"
      tar xzf "$file" -C "$DATA_DIR"
      chown "$SERVICE_USER:$SERVICE_USER" "$DATA_DIR"/.rvg_secret 2>/dev/null || true
      chmod 600 "$DATA_DIR/.rvg_secret" 2>/dev/null || true
      systemctl start "${SERVICE_NAME}.service"
      ok "Restored from $(basename "$file") — service restarted"
      ;;
    delete)
      local name="${1:?usage: rvg backup delete <name-or-file>}"
      [[ -f "$name" ]] || name="$BACKUP_DIR/$name"
      [[ -f "$name" ]] || die "Not found: $1"
      need_root backup delete
      rm -f -- "$name"
      ok "Deleted $(basename "$name")"
      ;;
    *) grep -A4 'Backups:' "$0" | sed 's/^# \{0,1\}//';;
  esac
}

cmd_update() {
  need_root update
  local updater="$APP_DIR/update.sh"
  [[ -f "$updater" ]] || die "update.sh not found in $APP_DIR"
  bash "$updater"
}

cmd_uninstall() {
  need_root uninstall
  local script="$APP_DIR/uninstall.sh"
  [[ -f "$script" ]] || die "uninstall.sh not found"
  bash "$script"
}

case "${1:-help}" in
  status)      cmd_status ;;
  start)       cmd_start ;;
  stop)        cmd_stop ;;
  restart)     cmd_restart ;;
  logs)        shift; cmd_logs "$@" ;;
  port)        shift; cmd_port "$@" ;;
  host)        shift; cmd_host "$@" ;;
  public-port) shift; cmd_public_port "$@" ;;
  tls)         shift; cmd_tls "$@" ;;
  password)    shift; cmd_password "$@" ;;
  logs-off)    cmd_logs_off ;;
  logs-on)     cmd_logs_on ;;
  phone-home)  shift; cmd_phone_home "$@" ;;
  firewall)    cmd_firewall ;;
  info)        cmd_info ;;
  backup)      shift; cmd_backup "$@" ;;
  update)      cmd_update ;;
  uninstall)   cmd_uninstall ;;
  help|-h|--help|"")
    sed -n '/^# Usage:/,/^# ══/p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) die "Unknown command: $1 — try 'rvg help'" ;;
esac
